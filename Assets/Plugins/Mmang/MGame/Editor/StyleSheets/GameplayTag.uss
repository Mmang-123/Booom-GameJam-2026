
.gameplay-tag-field {
    margin-left: 3.33px;
}

.gameplay-tag-display {
    align-self: center;
    flex-grow: 1;

    margin-top: 2px;

    padding-right: 20px;

    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;

    background-color: rgba(44, 44, 44, 0.8);
}

.gameplay-tag-display__label {
    -unity-font-style: bold;
}

.gameplay-tag-display-image {
    margin-left: 2px;

    height: 20px;
    width: 20px;

    background-image: url("project://database/Assets/Plugins/Mmang/MGame/Editor/ImageResources/_Popup@2x.png");
}