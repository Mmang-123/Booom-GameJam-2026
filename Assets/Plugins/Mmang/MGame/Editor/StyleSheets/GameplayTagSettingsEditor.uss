
.root {
    border-top-width: 4px;

    margin-left: 3px;
    margin-right: 3px;
    margin-top: 3px;
    margin-bottom: 3px;

    flex-grow: 1;
}


.unity-tree-view {
    background-color: rgb(48, 48, 48);
}

.unity-tree-view__item {
    background-color: rgba(0, 0, 0, 0.00);
}

.unity-tree-view__item:hover {
    background-color: rgba(131, 131, 131, 0.21);
}

.item-root {
    flex-direction: row;
    flex-grow: 1;
}

.unity-toggle {
    margin-top: 3px;
    margin-bottom: 3px;

    align-self: center;
}

.unity-toggle__text {
    margin-left: 5px;

    font-size: 16px;
    color: rgb(210, 210, 210);
    -unity-font-style: bold;
}

.tag-button {
    -unity-font-style: bold;
}