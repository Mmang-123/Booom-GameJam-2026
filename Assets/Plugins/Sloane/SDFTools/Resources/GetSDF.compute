#include "Packages/com.sloane.shader.generic/Includes/SDF/Packing.hlsl"

#pragma kernel InitializeSeedSingleChannel
#pragma kernel InitializeSeed
#pragma kernel JumpFlooding
#pragma kernel GetNearest
#pragma kernel CalculateDistance
#pragma kernel CalculateDistanceSingleChannel
#pragma kernel NormalizeDistance
#pragma kernel NormalizeDistanceSingleChannel
#pragma kernel NormalizeDistanceToSingleChannel
#pragma kernel FindMinMaxDistance
#pragma kernel FillBoundingDistance
#pragma kernel FillBoundingDistanceSingleChannel
#pragma kernel CombineInnerOuterSingle
#pragma kernel PackSDFToRGB

Texture2D<float> _SingleChannelSourceTexture;  // 用于单通道输入的纹理
Texture2D<float4> _SourceTexture;
Texture2D<float4> _PreviousBuffer;
RWTexture2D<float4> _CurrentBuffer;
Texture2D<float> _PreviousBufferSingle;
RWTexture2D<float> _CurrentBufferSingle;
RWStructuredBuffer<int> _MinMaxBuffer;  // [0]=max absolute distance

uint _Width;
uint _Height;
float _AlphaThreshold;
float _MaxDistance;  // 用于归一化的最大距离
bool _InvertSelection;  // 是否反向选择（用于内部SDF）
bool _IsNormalized;  // 输入是否已经归一化
bool _BoundaryDistance;
bool _Normalize;
int _NearestPointSearchRange;
uint _OffsetX;
uint _OffsetY;

uint _IterationTime;
uint _Iteration;

[numthreads(8,8,1)]
void InitializeSeedSingleChannel(uint3 id : SV_DispatchThreadID)
{
    uint2 coord = id.xy;
    float color = _SingleChannelSourceTexture[coord + uint2(_OffsetX, _OffsetY)];
    
    float width = float(_Width);
    float height = float(_Height);
    
    // 判断是否为种子点（支持反向选择）
    bool isSeed = _InvertSelection ? (color <= _AlphaThreshold) : (color > _AlphaThreshold);
    
    if (isSeed)
    {
        // RG: 归一化坐标, B: 1.0 表示是种子点, A: 保留原始 alpha
        _CurrentBuffer[coord] = float4(float(coord.x) / width, float(coord.y) / height, 1.0, 1.0);
    }
    else
    {
        // 非种子像素：RG 设为无效坐标, B: 0.0 表示非种子点
        _CurrentBuffer[coord] = float4(float(coord.x) / width, float(coord.y) / height, 0.0, 1.0);
    }
}

[numthreads(8,8,1)]
void InitializeSeed(uint3 id : SV_DispatchThreadID)
{
    uint2 coord = id.xy;
    float4 color = _SourceTexture[coord];
    
    float width = float(_Width);
    float height = float(_Height);
    
    // 判断是否为种子点（支持反向选择）
    bool isSeed = _InvertSelection ? (color.a <= _AlphaThreshold) : (color.a > _AlphaThreshold);
    
    if (isSeed)
    {
        // RG: 归一化坐标, B: 1.0 表示是种子点, A: 保留原始 alpha
        _CurrentBuffer[coord] = float4(float(coord.x) / width, float(coord.y) / height, 1.0, 1.0);
    }
    else
    {
        // 非种子像素：RG 设为无效坐标, B: 0.0 表示非种子点
        _CurrentBuffer[coord] = float4(float(coord.x) / width, float(coord.y) / height, 0.0, 1.0);
    }
}

int DistanceSquared(uint2 a, uint2 b)
{
    int dx = int(a.x) - int(b.x);
    int dy = int(a.y) - int(b.y);
    return dx * dx + dy * dy;
}

[numthreads(8,8,1)]
void JumpFlooding (uint3 id : SV_DispatchThreadID)
{
    uint step = pow(2, _IterationTime - _Iteration - 1);
    uint2 currentCoord = id.xy;
    float width = float(_Width);
    float height = float(_Height);
    uint2 currentSeed = uint2(uint(round(_CurrentBuffer[currentCoord].x * width)), uint(round(_CurrentBuffer[currentCoord].y * height)));
    
    if(_CurrentBuffer[currentCoord].z > 0.5)
    {
        for(int i = -1; i <= 1; i++)
        {
            for(int j = -1; j <= 1; j++)
            {
                int2 neighborCoordSigned = int2(currentCoord) + int2(i, j) * step;
                if(neighborCoordSigned.x < 0 || neighborCoordSigned.x >= int(_Width) || neighborCoordSigned.y < 0 || neighborCoordSigned.y >= int(_Height)) continue;
                if(i == 0 && j == 0) continue;
            
                uint2 neighborCoord = uint2(neighborCoordSigned);
                uint2 neighborSeed = uint2(uint(_CurrentBuffer[neighborCoord].x * width), uint(_CurrentBuffer[neighborCoord].y * height));

                if(neighborSeed.x == currentSeed.x && neighborSeed.y == currentSeed.y) continue;

                bool fillData = false;
                if(_CurrentBuffer[neighborCoord].z < 0.5) fillData = true;
                else if(DistanceSquared(neighborCoord, neighborSeed) > DistanceSquared(neighborCoord, currentSeed)) fillData = true;

                if(fillData)
                {
                    _CurrentBuffer[neighborCoord] = float4(float(currentSeed.x) / width, float(currentSeed.y) / height, 1.0, _CurrentBuffer[neighborCoord].a);
                }
            }
        }
    }
}

[numthreads(8,8,1)]
void GetNearest(uint3 id : SV_DispatchThreadID)
{
    uint2 currentCoord = id.xy;

    if (_PreviousBuffer[currentCoord].z > 0.5)
    {
        _CurrentBuffer[currentCoord] = _PreviousBuffer[currentCoord];
        return;
    }

    bool found = false;
    int minDistance = int(_Width * _Width + _Height * _Height); // 初始化为最大可能距离
    float width = float(_Width);
    float height = float(_Height);
    uint2 currentSeed = uint2(uint(_PreviousBuffer[currentCoord].x * width), uint(_PreviousBuffer[currentCoord].y * height));
    
    currentCoord = currentSeed;

    // 按回字形向外遍历
    int maxRadius = min(max(max(int(_Width - currentSeed.x - 1), int(currentSeed.x)), max(int(_Height - currentSeed.y - 1), int(currentSeed.y))), _NearestPointSearchRange);
    for (int radius = 1; radius <= maxRadius; radius++)
    {
        if (minDistance < radius * radius) break;
        // 遍历上边界
        for (int i = -radius; i <= radius; i++)
        {
            int2 neighborCoordSigned = int2(currentCoord) + int2(i, -radius);
            if (neighborCoordSigned.x < 0 || neighborCoordSigned.x >= int(_Width) || neighborCoordSigned.y < 0 || neighborCoordSigned.y >= int(_Height)) continue;

            uint2 neighborCoord = uint2(neighborCoordSigned);
            if (_PreviousBuffer[neighborCoord].z < 0.5) continue;

            int distance = DistanceSquared(neighborCoord, currentCoord);
            if (distance < minDistance)
            {
                minDistance = distance;
                currentSeed = neighborCoord;
                found = true;
            }
        }

        // 遍历下边界
        for (int j = -radius; j <= radius; j++)
        {
            int2 neighborCoordSigned = int2(currentCoord) + int2(j, radius);
            if (neighborCoordSigned.x < 0 || neighborCoordSigned.x >= int(_Width) || neighborCoordSigned.y < 0 || neighborCoordSigned.y >= int(_Height)) continue;

            uint2 neighborCoord = uint2(neighborCoordSigned);
            if (_PreviousBuffer[neighborCoord].z < 0.5) continue;

            int distance = DistanceSquared(neighborCoord, currentCoord);
            if (distance < minDistance)
            {
                minDistance = distance;
                currentSeed = neighborCoord;
                found = true;
            }
        }

        // 遍历左边界
        for (int k = -radius + 1; k <= radius - 1; k++)
        {
            int2 neighborCoordSigned = int2(currentCoord) + int2(-radius, k);
            if (neighborCoordSigned.x < 0 || neighborCoordSigned.x >= int(_Width) || neighborCoordSigned.y < 0 || neighborCoordSigned.y >= int(_Height)) continue;

            uint2 neighborCoord = uint2(neighborCoordSigned);
            if (_PreviousBuffer[neighborCoord].z < 0.5) continue;

            int distance = DistanceSquared(neighborCoord, currentCoord);
            if (distance < minDistance)
            {
                minDistance = distance;
                currentSeed = neighborCoord;
                found = true;
            }
        }

        // 遍历右边界
        for (int l = -radius + 1; l <= radius - 1; l++)
        {
            int2 neighborCoordSigned = int2(currentCoord) + int2(radius, l);
            if (neighborCoordSigned.x < 0 || neighborCoordSigned.x >= int(_Width) || neighborCoordSigned.y < 0 || neighborCoordSigned.y >= int(_Height)) continue;

            uint2 neighborCoord = uint2(neighborCoordSigned);
            if (_PreviousBuffer[neighborCoord].z < 0.5) continue;

            int distance = DistanceSquared(neighborCoord, currentCoord);
            if (distance < minDistance)
            {
                minDistance = distance;
                currentSeed = neighborCoord;
                found = true;
            }
        }
    }

    if (!found)
    {
        currentSeed = uint2(uint(2.0 * width), uint(round(2.0 * height)));
    }

    _CurrentBuffer[currentCoord] = float4(float(currentSeed.x) / _Width, float(currentSeed.y) / _Height, 1.0, 1.0);
}

// 像素 coord 到最近纹理边界的距离（像素单位）
float BoundaryDist(uint2 coord)
{
    return min(
        min(float(coord.x + 1), float(_Width) - float(coord.x)),
        min(float(coord.y + 1), float(_Height) - float(coord.y))
    );
}

[numthreads(8,8,1)]
void CalculateDistance(uint3 id : SV_DispatchThreadID)
{
    uint2 currentCoord = id.xy;
    float4 sdfData = _PreviousBuffer[currentCoord];
    
    float width = float(_Width);
    float height = float(_Height);
    
    // RG 通道存储最近点的归一化坐标
    float nearestX = sdfData.r * width;
    float nearestY = sdfData.g * height;
    
    // 计算距离
    float distance = 0.0;

    if (sdfData.b < 0.5)
    {
        // 没有被泛洪填充过的像素，距离为正
        distance = sqrt(width * width + height * height); // 初始化为最大可能距离
    }
    else
    {
        float dx = float(currentCoord.x) - nearestX;
        float dy = float(currentCoord.y) - nearestY;
        float distance = sqrt(dx * dx + dy * dy);
    }

    if (_BoundaryDistance)
        distance = min(distance, BoundaryDist(currentCoord));

    float out_val = _Normalize ? saturate(distance / _MaxDistance) : distance;
    // 输出通道
    _CurrentBuffer[currentCoord] = float4(out_val, out_val, out_val, 1.0);
}

[numthreads(8,8,1)]
void CalculateDistanceSingleChannel(uint3 id : SV_DispatchThreadID)
{
    uint2 currentCoord = id.xy;
    float4 sdfData = _PreviousBuffer[currentCoord];

    float width = float(_Width);
    float height = float(_Height);

    float nearestX = sdfData.r * width;
    float nearestY = sdfData.g * height;

    float dx = float(currentCoord.x) - nearestX;
    float dy = float(currentCoord.y) - nearestY;
    float distance = sqrt(dx * dx + dy * dy);

    if (_BoundaryDistance)
        distance = min(distance, BoundaryDist(currentCoord));

    float out_val = _Normalize ? saturate(distance / _MaxDistance) : distance;
    _CurrentBufferSingle[currentCoord] = out_val;
}

[numthreads(8,8,1)]
void NormalizeDistance(uint3 id : SV_DispatchThreadID)
{
    uint2 currentCoord = id.xy;
    float distance = _PreviousBuffer[currentCoord].r;
    
    // 归一化到 [0, 1] 范围，只考虑绝对值
    // distance 绝对值范围是 [0, maxDist]
    // 映射到 [0, 1]: abs(distance) / maxDist
    float normalizedDist = abs(distance) / _MaxDistance;
    normalizedDist = saturate(normalizedDist);  // 确保在 [0, 1] 范围内
    
    _CurrentBuffer[currentCoord] = float4(normalizedDist, normalizedDist, normalizedDist, 1.0);
}

[numthreads(8,8,1)]
void NormalizeDistanceSingleChannel(uint3 id : SV_DispatchThreadID)
{
    uint2 currentCoord = id.xy;
    float distance = _PreviousBufferSingle[currentCoord];

    float normalizedDist = abs(distance) / _MaxDistance;
    normalizedDist = saturate(normalizedDist);

    _CurrentBufferSingle[currentCoord] = normalizedDist;
}

[numthreads(8,8,1)]
void NormalizeDistanceToSingleChannel(uint3 id : SV_DispatchThreadID)
{
    uint2 currentCoord = id.xy;
    float distance = _PreviousBuffer[currentCoord].r;

    float normalizedDist = abs(distance) / _MaxDistance;
    normalizedDist = saturate(normalizedDist);

    _CurrentBufferSingle[currentCoord] = normalizedDist;
}

[numthreads(8,8,1)]
void FindMinMaxDistance(uint3 id : SV_DispatchThreadID)
{
    uint2 coord = id.xy;
    
    // 检查边界
    if (coord.x >= _Width || coord.y >= _Height)
        return;
    
    float distance = _PreviousBuffer[coord].r * 1000.0;  // 放大以保留小数部分
    
    // 如果是归一化的值，先反归一化回原始距离
    if (_IsNormalized)
    {
        // 反归一化：distance = (normalized * 2 - 1) * maxDist
        distance = distance * _MaxDistance;
    }
    
    // 取绝对值并转换为int
    int absDistance = int(ceil(distance));
    
    // 使用原子操作更新最大绝对值
    InterlockedMax(_MinMaxBuffer[0], absDistance);
}

// 全空时直接写入到纹理边界的距离（RGBA输出）
[numthreads(8,8,1)]
void FillBoundingDistance(uint3 id : SV_DispatchThreadID)
{
    uint2 coord = id.xy;
    if (coord.x >= _Width || coord.y >= _Height) return;

    float distance = BoundaryDist(coord);
    float out_val = _Normalize ? saturate(distance / _MaxDistance) : distance;
    _CurrentBuffer[coord] = float4(out_val, out_val, out_val, 1.0);
}

// 全空时直接写入到纹理边界的距离（单通道输出）
[numthreads(8,8,1)]
void FillBoundingDistanceSingleChannel(uint3 id : SV_DispatchThreadID)
{
    uint2 coord = id.xy;
    if (coord.x >= _Width || coord.y >= _Height) return;

    float distance = BoundaryDist(coord);
    float out_val = _Normalize ? saturate(distance / _MaxDistance) : distance;
    _CurrentBufferSingle[coord] = out_val;
}

[numthreads(8,8,1)]
void CombineInnerOuterSingle(uint3 id : SV_DispatchThreadID)
{
    uint2 coord = id.xy;
    if (coord.x >= _Width || coord.y >= _Height) return;

    float innerDist = _SingleChannelSourceTexture[coord].r;
    float outerDist = _PreviousBufferSingle[coord].r;

    float combinedDist = outerDist - innerDist;
    _CurrentBufferSingle[coord] = combinedDist;
}

[numthreads(8,8,1)]
void PackSDFToRGB(uint3 id : SV_DispatchThreadID)
{
    uint2 coord = id.xy;
    if (coord.x >= _Width || coord.y >= _Height) return;

    float distance = _PreviousBufferSingle[coord].r;
    float3 packedSDF = PackSDF(distance, _MaxDistance);
    _CurrentBuffer[coord] = float4(packedSDF, 1.0);
}
