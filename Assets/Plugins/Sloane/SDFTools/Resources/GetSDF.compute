#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
#include "Packages/com.sloane.shader.generic/Includes/SDF/Packing.hlsl"

#pragma kernel InitializeSeedSingleChannel
#pragma kernel InitializeSeed
#pragma kernel JumpFlooding
#pragma kernel GetNearest
#pragma kernel CalculateDistance
#pragma kernel CalculateDistanceSingleChannel
#pragma kernel NormalizeDistance
#pragma kernel NormalizeDistanceSingleChannel
#pragma kernel NormalizeDistanceToSingleChannel
#pragma kernel FindMinMaxDistance
#pragma kernel FillBoundingDistance
#pragma kernel FillBoundingDistanceSingleChannel
#pragma kernel CombineInnerOuterSingle
#pragma kernel PackSDFToRGB
#pragma kernel InitializeSeedSC_Batch
#pragma kernel JumpFlooding_Batch
#pragma kernel GetNearest_Batch
#pragma kernel CalculateDistanceSC_Batch

Texture2D<float> _SingleChannelSourceTexture;  // 用于单通道输入的纹理
Texture2D<float4> _SourceTexture;
Texture2D<float4> _PreviousBuffer;
RWTexture2D<float4> _CurrentBuffer;
Texture2D<float> _PreviousBufferSingle;
RWTexture2D<float> _CurrentBufferSingle;
RWStructuredBuffer<int> _MinMaxBuffer;  // [0]=max absolute distance

// Batch (Texture2DArray) resources
RWTexture2DArray<float4> _CurrentBufferArray;
Texture2DArray<float4> _PreviousBufferArray;
RWTexture2DArray<float> _CurrentBufferSCArray;
uint _BatchChunkRangeX;
uint _BatchChunkResolution;

uint _Width;
uint _Height;
float _AlphaThreshold;
float _MaxDistance;  // 用于归一化的最大距离
bool _InvertSelection;  // 是否反向选择（用于内部SDF）
bool _BoundaryDistance;
bool _Normalize;
bool _AccurateDistance;  // 是否使用更精确的距离计算（考虑像素中心）
int _NearestPointSearchRange;
uint _OffsetX;
uint _OffsetY;
uint _ExtendPixels;

uint _IterationTime;
uint _Iteration;

[numthreads(8,8,1)]
void InitializeSeedSingleChannel(uint3 id : SV_DispatchThreadID)
{
    uint2 coord = id.xy;
    float color = _SingleChannelSourceTexture[coord + uint2(_OffsetX, _OffsetY)];
    
    float width = float(_Width);
    float height = float(_Height);
    
    // 判断是否为种子点（支持反向选择）
    bool isSeed = _InvertSelection ? (color <= _AlphaThreshold) : (color > _AlphaThreshold);
    
    if (isSeed)
    {
        // RG: 归一化坐标, B: 1.0 表示是种子点, A: 保留原始 alpha
        _CurrentBuffer[coord] = float4(float(coord.x) / width, float(coord.y) / height, 1.0, 1.0);
    }
    else
    {
        // 非种子像素：RG 设为无效坐标, B: 0.0 表示非种子点
        _CurrentBuffer[coord] = float4(float(coord.x) / width, float(coord.y) / height, 0.0, 0.0);
    }
}

[numthreads(8,8,1)]
void InitializeSeed(uint3 id : SV_DispatchThreadID)
{
    uint2 coord = id.xy;
    float4 color = _SourceTexture[coord + uint2(_OffsetX, _OffsetY)];
    
    float width = float(_Width);
    float height = float(_Height);
    
    // 判断是否为种子点（支持反向选择）
    bool isSeed = _InvertSelection ? (color.a <= _AlphaThreshold) : (color.a > _AlphaThreshold);
    
    if (isSeed)
    {
        // RG: 归一化坐标, B: 1.0 表示是种子点, A: 保留原始 alpha
        _CurrentBuffer[coord] = float4(float(coord.x) / width, float(coord.y) / height, 1.0, 1.0);
    }
    else
    {
        // 非种子像素：RG 设为无效坐标, B: 0.0 表示非种子点
        _CurrentBuffer[coord] = float4(float(coord.x) / width, float(coord.y) / height, 0.0, 0.0);
    }
}

int DistanceSquared(uint2 a, uint2 b)
{
    int dx = int(a.x) - int(b.x);
    int dy = int(a.y) - int(b.y);
    return dx * dx + dy * dy;
}

[numthreads(8,8,1)]
void JumpFlooding (uint3 id : SV_DispatchThreadID)
{
    uint2 currentCoord = id.xy;
    uint step = (uint)pow(2.0, float(_IterationTime - _Iteration - 1));
    float width = float(_Width);
    float height = float(_Height);

    // Gather：从上一轮快照（_PreviousBuffer）读取，只写自己的像素，消除并发写冲突
    float4 selfData = _PreviousBuffer[currentCoord];
    uint2 bestSeed = uint2(uint(round(selfData.x * width)), uint(round(selfData.y * height)));
    int minDist = selfData.z > 0.5 ? DistanceSquared(currentCoord, bestSeed) : 2147483647;

    for (int i = -1; i <= 1; i++)
    {
        for (int j = -1; j <= 1; j++)
        {
            if (i == 0 && j == 0) continue;
            int2 neighborCoordSigned = int2(currentCoord) + int2(i, j) * int(step);
            if (neighborCoordSigned.x < 0 || neighborCoordSigned.x >= int(_Width) || neighborCoordSigned.y < 0 || neighborCoordSigned.y >= int(_Height)) continue;

            uint2 neighborCoord = uint2(neighborCoordSigned);
            float4 neighborData = _PreviousBuffer[neighborCoord];
            if (neighborData.z < 0.5) continue;

            uint2 neighborSeed = uint2(uint(round(neighborData.x * width)), uint(round(neighborData.y * height)));
            int dist = DistanceSquared(currentCoord, neighborSeed);
            if (dist < minDist)
            {
                minDist = dist;
                bestSeed = neighborSeed;
            }
        }
    }

    if (minDist < 2147483647)
        _CurrentBuffer[currentCoord] = float4(float(bestSeed.x) / width, float(bestSeed.y) / height, 1.0, selfData.a);
    else
        _CurrentBuffer[currentCoord] = float4(selfData.xy, 0.0, selfData.a);
}

[numthreads(8,8,1)]
void GetNearest(uint3 id : SV_DispatchThreadID)
{
    uint2 currentCoord = id.xy + uint2(_ExtendPixels, _ExtendPixels);

    if (_PreviousBuffer[currentCoord].a > 0.5)
    {
        // 已经是种子点了，直接复制坐标
        _CurrentBuffer[currentCoord] = _PreviousBuffer[currentCoord];
        return;
    }

    bool found = false;
    float width = float(_Width);
    float height = float(_Height);
    uint2 currentSeed = uint2(uint(_PreviousBuffer[currentCoord].x * width), uint(_PreviousBuffer[currentCoord].y * height));
    int minDistance = DistanceSquared(currentCoord, currentSeed);
    int originalDistance = minDistance;
    uint2 originalSeed = currentSeed;

    uint2 originalCoord = currentCoord;
    currentCoord = currentSeed;

    // 按回字形向外遍历
    int maxRadius = min(max(max(int(_Width - currentSeed.x - 1), int(currentSeed.x)), max(int(_Height - currentSeed.y - 1), int(currentSeed.y))), _NearestPointSearchRange);
    for (int radius = 1; radius <= maxRadius; radius++)
    {
        if (originalDistance < radius * radius) break;
        // 遍历上边界
        for (int i = -radius; i <= radius; i++)
        {
            int2 neighborCoordSigned = int2(currentCoord) + int2(i, -radius);
            if (neighborCoordSigned.x < 0 || neighborCoordSigned.x >= int(_Width) || neighborCoordSigned.y < 0 || neighborCoordSigned.y >= int(_Height)) continue;

            uint2 neighborCoord = uint2(neighborCoordSigned);
            if (_PreviousBuffer[neighborCoord].a < 0.5) continue;

            int distance = DistanceSquared(neighborCoord, originalCoord);
            if (distance < minDistance)
            {
                minDistance = distance;
                currentSeed = neighborCoord;
                found = true;
            }
        }

        // 遍历下边界
        for (int j = -radius; j <= radius; j++)
        {
            int2 neighborCoordSigned = int2(currentCoord) + int2(j, radius);
            if (neighborCoordSigned.x < 0 || neighborCoordSigned.x >= int(_Width) || neighborCoordSigned.y < 0 || neighborCoordSigned.y >= int(_Height)) continue;

            uint2 neighborCoord = uint2(neighborCoordSigned);
            if (_PreviousBuffer[neighborCoord].a < 0.5) continue;

            int distance = DistanceSquared(neighborCoord, originalCoord);
            if (distance < minDistance)
            {
                minDistance = distance;
                currentSeed = neighborCoord;
                found = true;
            }
        }

        // 遍历左边界
        for (int k = -radius + 1; k <= radius - 1; k++)
        {
            int2 neighborCoordSigned = int2(currentCoord) + int2(-radius, k);
            if (neighborCoordSigned.x < 0 || neighborCoordSigned.x >= int(_Width) || neighborCoordSigned.y < 0 || neighborCoordSigned.y >= int(_Height)) continue;

            uint2 neighborCoord = uint2(neighborCoordSigned);
            if (_PreviousBuffer[neighborCoord].a < 0.5) continue;

            int distance = DistanceSquared(neighborCoord, originalCoord);
            if (distance < minDistance)
            {
                minDistance = distance;
                currentSeed = neighborCoord;
                found = true;
            }
        }

        // 遍历右边界
        for (int l = -radius + 1; l <= radius - 1; l++)
        {
            int2 neighborCoordSigned = int2(currentCoord) + int2(radius, l);
            if (neighborCoordSigned.x < 0 || neighborCoordSigned.x >= int(_Width) || neighborCoordSigned.y < 0 || neighborCoordSigned.y >= int(_Height)) continue;

            uint2 neighborCoord = uint2(neighborCoordSigned);
            if (_PreviousBuffer[neighborCoord].a < 0.5) continue;

            int distance = DistanceSquared(neighborCoord, originalCoord);
            if (distance < minDistance)
            {
                minDistance = distance;
                currentSeed = neighborCoord;
                found = true;
            }
        }
    }
    
    _CurrentBuffer[originalCoord] = float4(float(currentSeed.x) / width, float(currentSeed.y) / height, _PreviousBuffer[originalCoord].z, 1.0);
}

// 像素 coord 到最近纹理边界的距离（像素单位）
float BoundaryDist(uint2 coord)
{
    return min(
        min(float(coord.x + 1), float(_Width) - float(coord.x)),
        min(float(coord.y + 1), float(_Height) - float(coord.y))
    );
}

[numthreads(8,8,1)]
void CalculateDistance(uint3 id : SV_DispatchThreadID)
{
    uint2 currentCoord = id.xy;
    uint2 extendedCoord = currentCoord + uint2(_ExtendPixels, _ExtendPixels);
    float4 sdfData = _PreviousBuffer[extendedCoord];
    
    float width = float(_Width);
    float height = float(_Height);
    
    // RG 通道存储最近点的归一化坐标
    float nearestX = sdfData.r * width;
    float nearestY = sdfData.g * height;
    
    // 计算距离
    float distance = 0.0;

    if (sdfData.b < 0.5)
    {
        distance = _ExtendPixels == 0 ? min(width, height) : _ExtendPixels;
    }
    else
    {
        float dx = float(extendedCoord.x) - nearestX;
        float dy = float(extendedCoord.y) - nearestY;

        if (_AccurateDistance)
        {
            float absDx = abs(dx);
            float absDy = abs(dy);

            if(absDx > absDy)
            {
                dx = dx - sign(dx) * 0.5;
            }
            else if(absDy > absDx)
            {
                dy = dy - sign(dy) * 0.5;
            }
            else if(absDx == absDy && absDx > 0) // 对于完全对角线的情况，两个方向都减去0.5
            {
                dx = dx - sign(dx) * 0.5;
                dy = dy - sign(dy) * 0.5;
            }
        }

        distance = sqrt(dx * dx + dy * dy);
    }

    if (_BoundaryDistance)
        distance = min(distance, BoundaryDist(extendedCoord));

    float out_val = _Normalize ? saturate(distance / _MaxDistance) : distance;
    // 输出通道
    _CurrentBuffer[currentCoord] = float4(out_val, out_val, out_val, 1.0);
}

[numthreads(8,8,1)]
void CalculateDistanceSingleChannel(uint3 id : SV_DispatchThreadID)
{
    uint2 currentCoord = id.xy;
    uint2 extendedCoord = currentCoord + uint2(_ExtendPixels, _ExtendPixels);
    float4 sdfData = _PreviousBuffer[extendedCoord];

    float width = float(_Width);
    float height = float(_Height);

    float nearestX = sdfData.r * width;
    float nearestY = sdfData.g * height;

    // 计算距离
    float distance = 0.0;

    if (sdfData.b < 0.5)
    {
        distance = _ExtendPixels == 0 ? min(width, height) : _ExtendPixels;
    }
    else
    {
        float dx = float(extendedCoord.x) - nearestX;
        float dy = float(extendedCoord.y) - nearestY;

        if (_AccurateDistance)
        {
            float absDx = abs(dx);
            float absDy = abs(dy);

            if(absDx > absDy)
            {
                dx = dx - sign(dx) * 0.5;
            }
            else if(absDy > absDx)
            {
                dy = dy - sign(dy) * 0.5;
            }
            else if(absDx == absDy && absDx > 0) // 对于完全对角线的情况，两个方向都减去0.5
            {
                dx = dx - sign(dx) * 0.5;
                dy = dy - sign(dy) * 0.5;
            }
        }

        distance = sqrt(dx * dx + dy * dy);
    }

    if (_BoundaryDistance)
        distance = min(distance, BoundaryDist(extendedCoord));

    float out_val = _Normalize ? saturate(distance / _MaxDistance) : distance;
    _CurrentBufferSingle[currentCoord] = out_val;
}

[numthreads(8,8,1)]
void NormalizeDistance(uint3 id : SV_DispatchThreadID)
{
    uint2 currentCoord = id.xy;
    float distance = _PreviousBuffer[currentCoord].r;
    
    // 归一化到 [0, 1] 范围，只考虑绝对值
    // distance 绝对值范围是 [0, maxDist]
    // 映射到 [0, 1]: abs(distance) / maxDist
    float normalizedDist = abs(distance) / _MaxDistance;
    normalizedDist = saturate(normalizedDist);  // 确保在 [0, 1] 范围内
    
    _CurrentBuffer[currentCoord] = float4(normalizedDist, normalizedDist, normalizedDist, 1.0);
}

[numthreads(8,8,1)]
void NormalizeDistanceSingleChannel(uint3 id : SV_DispatchThreadID)
{
    uint2 currentCoord = id.xy;
    float distance = _PreviousBufferSingle[currentCoord];

    float normalizedDist = abs(distance) / _MaxDistance;
    normalizedDist = saturate(normalizedDist);

    _CurrentBufferSingle[currentCoord] = normalizedDist;
}

[numthreads(8,8,1)]
void NormalizeDistanceToSingleChannel(uint3 id : SV_DispatchThreadID)
{
    uint2 currentCoord = id.xy;
    float distance = _PreviousBuffer[currentCoord].r;

    float normalizedDist = abs(distance) / _MaxDistance;
    normalizedDist = saturate(normalizedDist);

    _CurrentBufferSingle[currentCoord] = normalizedDist;
}

[numthreads(8,8,1)]
void FindMinMaxDistance(uint3 id : SV_DispatchThreadID)
{
    uint2 coord = id.xy;
    
    // 检查边界
    if (coord.x >= _Width || coord.y >= _Height)
        return;
    
    float distance = _PreviousBuffer[coord].r * 1000.0;  // 放大以保留小数部分
    
    // 如果是归一化的值，先反归一化回原始距离
    if (_Normalize)
    {
        // 反归一化：distance = (normalized * 2 - 1) * maxDist
        distance = distance * _MaxDistance;
    }
    
    // 取绝对值并转换为int
    int absDistance = int(ceil(distance));
    
    // 使用原子操作更新最大绝对值
    InterlockedMax(_MinMaxBuffer[0], absDistance);
}

// 全空时直接写入到纹理边界的距离（RGBA输出）
[numthreads(8,8,1)]
void FillBoundingDistance(uint3 id : SV_DispatchThreadID)
{
    uint2 coord = id.xy;
    if (coord.x >= _Width || coord.y >= _Height) return;

    float distance = BoundaryDist(coord);
    float out_val = _Normalize ? saturate(distance / _MaxDistance) : distance;
    _CurrentBuffer[coord] = float4(out_val, out_val, out_val, 1.0);
}

// 全空时直接写入到纹理边界的距离（单通道输出）
[numthreads(8,8,1)]
void FillBoundingDistanceSingleChannel(uint3 id : SV_DispatchThreadID)
{
    uint2 coord = id.xy;
    if (coord.x >= _Width || coord.y >= _Height) return;

    float distance = BoundaryDist(coord);
    float out_val = _Normalize ? saturate(distance / _MaxDistance) : distance;
    _CurrentBufferSingle[coord] = out_val;
}

[numthreads(8,8,1)]
void CombineInnerOuterSingle(uint3 id : SV_DispatchThreadID)
{
    uint2 coord = id.xy;
    if (coord.x >= _Width || coord.y >= _Height) return;

    float innerDist = _SingleChannelSourceTexture[coord].r;
    float outerDist = _PreviousBufferSingle[coord].r;

    float combinedDist = outerDist - innerDist;
    _CurrentBufferSingle[coord] = combinedDist;
}

[numthreads(8,8,1)]
void PackSDFToRGB(uint3 id : SV_DispatchThreadID)
{
    uint2 coord = id.xy;
    if (coord.x >= _Width || coord.y >= _Height) return;

    float distance = _PreviousBufferSingle[coord].r;
    float3 packedSDF = PackSDF(distance, _MaxDistance);
    _CurrentBuffer[coord] = float4(packedSDF, 1.0);
}

// ---------------------------------------------------------------------------
// Batch kernels: process all chunks in a single dispatch using Z = chunk index
// ---------------------------------------------------------------------------

[numthreads(8,8,1)]
void InitializeSeedSC_Batch(uint3 id : SV_DispatchThreadID)
{
    uint2 coord = id.xy;
    uint sliceIndex = id.z;
    float width  = float(_Width);
    float height = float(_Height);
    uint chunkX = sliceIndex % _BatchChunkRangeX;
    uint chunkY = sliceIndex / _BatchChunkRangeX;
    uint2 srcOffset = uint2(chunkX * _BatchChunkResolution, chunkY * _BatchChunkResolution);
    float color = _SingleChannelSourceTexture[coord + srcOffset];
    bool isSeed = _InvertSelection ? (color <= _AlphaThreshold) : (color > _AlphaThreshold);
    if (isSeed)
        _CurrentBufferArray[uint3(coord, sliceIndex)] = float4(float(coord.x) / width, float(coord.y) / height, 1.0, 1.0);
    else
        _CurrentBufferArray[uint3(coord, sliceIndex)] = float4(float(coord.x) / width, float(coord.y) / height, 0.0, 0.0);
}

[numthreads(8,8,1)]
void JumpFlooding_Batch(uint3 id : SV_DispatchThreadID)
{
    uint2 currentCoord = id.xy;
    uint sliceIndex = id.z;
    uint step = (uint)pow(2.0, float(_IterationTime - _Iteration - 1));
    float width  = float(_Width);
    float height = float(_Height);

    float4 selfData = _PreviousBufferArray[uint3(currentCoord, sliceIndex)];
    uint2 bestSeed = uint2(uint(round(selfData.x * width)), uint(round(selfData.y * height)));
    int minDist = selfData.z > 0.5 ? DistanceSquared(currentCoord, bestSeed) : 2147483647;

    for (int i = -1; i <= 1; i++)
    {
        for (int j = -1; j <= 1; j++)
        {
            if (i == 0 && j == 0) continue;
            int2 neighborCoordSigned = int2(currentCoord) + int2(i, j) * int(step);
            if (neighborCoordSigned.x < 0 || neighborCoordSigned.x >= int(_Width) ||
                neighborCoordSigned.y < 0 || neighborCoordSigned.y >= int(_Height)) continue;
            uint2 neighborCoord = uint2(neighborCoordSigned);
            float4 neighborData = _PreviousBufferArray[uint3(neighborCoord, sliceIndex)];
            if (neighborData.z < 0.5) continue;
            uint2 neighborSeed = uint2(uint(round(neighborData.x * width)), uint(round(neighborData.y * height)));
            int dist = DistanceSquared(currentCoord, neighborSeed);
            if (dist < minDist) { minDist = dist; bestSeed = neighborSeed; }
        }
    }

    if (minDist < 2147483647)
        _CurrentBufferArray[uint3(currentCoord, sliceIndex)] = float4(float(bestSeed.x) / width, float(bestSeed.y) / height, 1.0, selfData.a);
    else
        _CurrentBufferArray[uint3(currentCoord, sliceIndex)] = float4(selfData.xy, 0.0, selfData.a);
}

[numthreads(8,8,1)]
void GetNearest_Batch(uint3 id : SV_DispatchThreadID)
{
    uint2 currentCoord = id.xy + uint2(_ExtendPixels, _ExtendPixels);
    uint sliceIndex = id.z;

    float4 selfData = _PreviousBufferArray[uint3(currentCoord, sliceIndex)];
    if (selfData.a > 0.5)
    {
        _CurrentBufferArray[uint3(currentCoord, sliceIndex)] = selfData;
        return;
    }

    float width  = float(_Width);
    float height = float(_Height);
    uint2 currentSeed = uint2(uint(selfData.x * width), uint(selfData.y * height));
    int minDistance = DistanceSquared(currentCoord, currentSeed);
    int originalDistance = minDistance;
    uint2 originalCoord = currentCoord;
    currentCoord = currentSeed;

    int maxRadius = min(max(max(int(_Width  - currentSeed.x - 1), int(currentSeed.x)),
                            max(int(_Height - currentSeed.y - 1), int(currentSeed.y))),
                        _NearestPointSearchRange);
    for (int radius = 1; radius <= maxRadius; radius++)
    {
        if (originalDistance < radius * radius) break;
        for (int i = -radius; i <= radius; i++)
        {
            int2 c = int2(currentCoord) + int2(i, -radius);
            if (c.x < 0 || c.x >= int(_Width) || c.y < 0 || c.y >= int(_Height)) continue;
            uint2 nc = uint2(c);
            if (_PreviousBufferArray[uint3(nc, sliceIndex)].a < 0.5) continue;
            int d = DistanceSquared(nc, originalCoord);
            if (d < minDistance) { minDistance = d; currentSeed = nc; }
        }
        for (int j = -radius; j <= radius; j++)
        {
            int2 c = int2(currentCoord) + int2(j, radius);
            if (c.x < 0 || c.x >= int(_Width) || c.y < 0 || c.y >= int(_Height)) continue;
            uint2 nc = uint2(c);
            if (_PreviousBufferArray[uint3(nc, sliceIndex)].a < 0.5) continue;
            int d = DistanceSquared(nc, originalCoord);
            if (d < minDistance) { minDistance = d; currentSeed = nc; }
        }
        for (int k = -radius + 1; k <= radius - 1; k++)
        {
            int2 c = int2(currentCoord) + int2(-radius, k);
            if (c.x < 0 || c.x >= int(_Width) || c.y < 0 || c.y >= int(_Height)) continue;
            uint2 nc = uint2(c);
            if (_PreviousBufferArray[uint3(nc, sliceIndex)].a < 0.5) continue;
            int d = DistanceSquared(nc, originalCoord);
            if (d < minDistance) { minDistance = d; currentSeed = nc; }
        }
        for (int l = -radius + 1; l <= radius - 1; l++)
        {
            int2 c = int2(currentCoord) + int2(radius, l);
            if (c.x < 0 || c.x >= int(_Width) || c.y < 0 || c.y >= int(_Height)) continue;
            uint2 nc = uint2(c);
            if (_PreviousBufferArray[uint3(nc, sliceIndex)].a < 0.5) continue;
            int d = DistanceSquared(nc, originalCoord);
            if (d < minDistance) { minDistance = d; currentSeed = nc; }
        }
    }
    _CurrentBufferArray[uint3(originalCoord, sliceIndex)] = float4(
        float(currentSeed.x) / width, float(currentSeed.y) / height, selfData.z, 1.0);
}

[numthreads(8,8,1)]
void CalculateDistanceSC_Batch(uint3 id : SV_DispatchThreadID)
{
    uint2 currentCoord  = id.xy;
    uint  sliceIndex    = id.z;
    uint2 extendedCoord = currentCoord + uint2(_ExtendPixels, _ExtendPixels);
    float4 sdfData = _PreviousBufferArray[uint3(extendedCoord, sliceIndex)];
    float width  = float(_Width);
    float height = float(_Height);
    float nearestX = sdfData.r * width;
    float nearestY = sdfData.g * height;
    float distance = 0.0;
    if (sdfData.b < 0.5)
    {
        distance = _ExtendPixels == 0 ? min(width, height) : float(_ExtendPixels);
    }
    else
    {
        float dx = float(extendedCoord.x) - nearestX;
        float dy = float(extendedCoord.y) - nearestY;
        if (_AccurateDistance)
        {
            float absDx = abs(dx); float absDy = abs(dy);
            if      (absDx > absDy) dx = dx - sign(dx) * 0.5;
            else if (absDy > absDx) dy = dy - sign(dy) * 0.5;
            else if (absDx == absDy && absDx > 0) { dx = dx - sign(dx) * 0.5; dy = dy - sign(dy) * 0.5; }
        }
        distance = sqrt(dx * dx + dy * dy);
    }
    if (_BoundaryDistance) distance = min(distance, BoundaryDist(extendedCoord));
    _CurrentBufferSCArray[uint3(currentCoord, sliceIndex)] = _Normalize ? saturate(distance / _MaxDistance) : distance;
}
